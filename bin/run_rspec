#!/usr/bin/env bash
# Run rspec with JVM options required for Apache Arrow (shared memory).
# Plain `rspec` fails with: "Unable to make field long java.nio.Buffer.address accessible"
# because the JVM must be started with --add-opens=java.base/java.nio=...
#
# Usage:
#   bin/run_rspec              # run all specs (*_spec.rb and *.spec.rb in specs/)
#   bin/run_rspec specs/protocol_result_spec.rb
#   GALAAZ_DEBUG=1 bin/run_rspec specs/r_vector_subsetting.spec.rb:61 ...
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ $# -eq 0 ]; then
  set -- $(find "$ROOT/specs" -maxdepth 1 -type f \( -name '*_spec.rb' -o -name '*.spec.rb' \) | sort)
fi
exec jruby -I "$ROOT/lib" \
  -J--add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED \
  -S rspec "$@"

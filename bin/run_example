#!/usr/bin/env bash
# Run a Galaaz example with the same JRuby and JVM options as the specs.
#
# Usage: bin/run_example examples/sthda_ggplot/all.rb
#        bin/run_example examples/sthda_ggplot/one_variable_continuous/geom_density.rb
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec jruby -I "$ROOT/lib" \
  -J--add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED \
  "$@"
